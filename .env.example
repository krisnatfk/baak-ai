# =========================================================
#  BAAK AI — Environment Variables
#  Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#  JANGAN PERNAH commit `.env`.
# =========================================================

# ---- Aplikasi ----
# URL publik aplikasi (untuk redirect/callback auth).
#   Docker : http://localhost:3010
#   Dev    : http://localhost:3001
APP_URL=http://localhost:3001

# ---- Database (PostgreSQL 16 + pgvector) ----
# Di dalam Docker, host database adalah nama service `postgres`.
#   Docker : postgresql://baak:baak_pass@postgres:5432/baak_ai
#   Host   : postgresql://baak:baak_pass@localhost:5433/baak_ai
DATABASE_URL=postgresql://baak:baak_pass@localhost:5433/baak_ai

# ---- Auth (NextAuth v4, JWT) ----
# AUTH_SECRET : kunci penandatangan JWT. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=ganti-dengan-secret-acak-min-32-karakter-abcdefgh
# Umur sesi dalam detik (default 8 jam).
AUTH_MAX_AGE_SECONDS=28800

# ---- Internal API (dipanggil n8n/WAHA) ----
# Kunci untuk mengakses /api/rag/* dan /api/health internal. Minimal 32 karakter.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
INTERNAL_API_KEY=ganti-dengan-internal-api-key-acak-min-32-karakter-xyz

# ---- Embedding (abstraksi, WAJIB lokal — tidak ada ketergantungan OpenAI) ----
# Provider:
#   - "openai-compatible" : Ollama / LM Studio / vLLM (endpoint /v1/embeddings)
#   - "hash"              : fallback deterministik untuk development/smoke test
#                           (BUKAN retrieval semantik yang valid — hanya untuk dev).
# Default dev = hash. Untuk produksi set "openai-compatible".
EMBEDDING_PROVIDER=hash
# Contoh Ollama bge-m3:
#   ollama pull bge-m3
#   EMbedding base harus mengarah ke /v1 dari server embedding.
EMBEDDING_BASE_URL=http://localhost:11434/v1
# API key opsional (vLLM / gateway membutuhkan Bearer key).
EMBEDDING_API_KEY=
# Nama model embedding.
EMBEDDING_MODEL=bge-m3
# Dimensi vektor — WAJIB sama dengan kolom `embedding` pada migrasi database.
# bge-m3 = 1024, nomic-embed-text = 768, all-MiniLM-L6-v2 = 384.
EMBEDDING_DIMENSION=1024
# Ukuran batch saat memproses antrian embedding (FAQ baru/gagal/diubah).
EMBEDDING_BATCH_SIZE=10

# ---- LLM (Generate FAQ dari dokumen) ----
# Endpoint chat completion openai-compatible. Default mengikuti EMBEDDING_BASE_URL.
#   Ollama : http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
# Nama model LLM (harus sudah di-pull di Ollama, mis. `ollama pull qwen2.5`).
LLM_MODEL=qwen2.5
# API key opsional (vLLM / gateway membutuhkan Bearer key).
LLM_API_KEY=
# Temperatur generasi (0..2). Rendah = lebih deterministik.
LLM_TEMPERATURE=0.2

# ---- RAG / Retrieval ----
# Jumlah hasil maksimum yang dikembalikan.
RAG_MAX_RESULTS=5
# Ladder confidence. HARUS berlaku: 0 < MEDIUM < HIGH <= 1.
RAG_THRESHOLD_HIGH=0.70
RAG_THRESHOLD_MEDIUM=0.50
# Margin minimum selisih score hasil #1 vs #2 agar dianggap HIGH (koreksi off-topic).
RAG_HIGH_MARGIN=0.02
# Rate limit internal API (permintaan per menit per kunci/IP) -> HTTP 429.
RAG_RATE_LIMIT_PER_MINUTE=60

# ---- Upload dokumen ----
# Ukuran maksimum per file (MB). Ditegakkan di sisi server.
MAX_UPLOAD_MB=15
# Direktori penyimpanan file (di Docker: volume baak_uploads -> /app/uploads).
UPLOAD_DIR=uploads
